<resources xmlns:tools="http://schemas.android.com/tools">
    
    <style name="Base.Theme.VotacionesYElecciones" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/azul_primario</item>
        <item name="colorPrimaryVariant">@color/azul_primario_oscuro</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dorado_acento</item>
        <item name="colorOnSecondary">@color/texto_primario</item>
        <item name="android:windowBackground">@color/fondo_app</item>
        <item name="android:statusBarColor">@color/azul_primario_oscuro</item>
    </style>

    <style name="Theme.VotacionesYElecciones" parent="Base.Theme.VotacionesYElecciones" />

    
    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/azul_primario</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    
    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/azul_primario</item>
        <item name="android:textColor">@color/azul_primario</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    
    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/azul_primario</item>
    </style>
</resources>
